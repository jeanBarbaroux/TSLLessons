.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Package-manager caches and debug logs
.npm/
.npm-cache/
.yarn/cache/
.yarn/install-state.gz
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment and local configuration
.env
.env.*
!.env.example
!.env.sample
*.local

# Build output and generated files
dist/
**/dist/
build/
**/build/
out/
**/out/
coverage/
**/coverage/
.nyc_output/
.cache/
**/.cache/
.parcel-cache/
**/.parcel-cache/
.turbo/
**/.turbo/
.next/
**/.next/
.nuxt/
**/.nuxt/
.svelte-kit/
**/.svelte-kit/
.vite/
**/.vite/
*.tsbuildinfo

# Temporary files
tmp/
**/tmp/
temp/
**/temp/
*.tmp
*.temp
*.swp
*.swo
*~

# Operating-system files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs and editors
.idea/
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries/
.idea/**/shelf/
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace

# Test and tooling artifacts
*.lcov
reports/
**/reports/
.eslintcache
.stylelintcache
